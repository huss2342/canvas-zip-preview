{
  "manifest_version": 3,
  "name": "Canvas ZIP Preview",
  "version": "1.2.0",
  "description": "Preview ZIP submissions in Canvas SpeedGrader without saving or extracting files.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Canvas ZIP Preview",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.amazonaws.com/*",
    "https://*.canvas-user-content.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*"],
      "js": ["zip-reader.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
